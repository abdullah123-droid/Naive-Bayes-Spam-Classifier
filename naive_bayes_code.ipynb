plt.xticks(x, results_df['Metric'])
plt.ylabel('Percentage (%)')
plt.title('Model Performance Comparison: 80:20 vs 60:40 Split')
plt.legend()
plt.grid(axis='y', linestyle='--', alpha=0.7)
plt.tight_layout()
plt.savefig('performance_comparison_bar_chart.png', dpi=300, bbox_inches='tight')

print(f"| Accuracy         | {acc_80:.4f}          | {acc_60:.4f}          |")
print(f"| Precision        | {prec_80:.4f}          | {prec_60:.4f}          |")
print(f"| Recall           | {rec_80:.4f}          | {rec_60:.4f}          |")
print(f"| Specificity      | {spec_80:.4f}          | {spec_60:.4f}          |")
print(f"| F1-Score         | {f1_80:.4f}          | {f1_60:.4f}          |")
print("+" + "-"*70 + "+")

print(f"\nConfusion Matrix Values:")
print(f"80:20 Split - TP: {tp_80}, FN: {fn_80}, FP: {fp_80}, TN: {tn_80}")
print(f"60:40 Split - TP: {tp_60}, FN: {fn_60}, FP: {fp_60}, TN: {tn_60}")

print(f"\nSpecificity Manual Calculation:")
print(f"80:20 Split = TN/(TN+FP) = {tn_80}/({tn_80}+{fp_80}) = {tn_80/(tn_80+fp_80):.4f}")
print(f"60:40 Split = TN/(TN+FP) = {tn_60}/({tn_60}+{fp_60}) = {tn_60/(tn_60+fp_60):.4f}")

fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 6))
sns.heatmap(cm_80, annot=True, fmt='d', cmap='Blues', ax=ax1,
            xticklabels=['Predicted Non-Spam', 'Predicted Spam'],
            yticklabels=['Actual Non-Spam', 'Actual Spam'])
ax1.set_title('Confusion Matrix - 80:20 Split')
ax1.set_xlabel('Predicted Label')
ax1.set_ylabel('Actual Label')
sns.heatmap(cm_60, annot=True, fmt='d', cmap='Blues', ax=ax2,
            xticklabels=['Predicted Non-Spam', 'Predicted Spam'],
            yticklabels=['Actual Non-Spam', 'Actual Spam'])
ax2.set_title('Confusion Matrix - 60:40 Split')
ax2.set_xlabel('Predicted Label')
ax2.set_ylabel('Actual Label')
plt.tight_layout()
plt.savefig('confusion_matrix_heatmaps.png', dpi=300, bbox_inches='tight')
plt.show()

results_df = pd.DataFrame({
    'Metric': ['Accuracy', 'Precision', 'Recall', 'Specificity', 'F1-Score'],
    '80_20_Split': [acc_80, prec_80, rec_80, spec_80, f1_80],
    '60_40_Split': [acc_60, prec_60, rec_60, spec_60, f1_60]
})
results_df['Difference'] = (results_df['60_40_Split'] - results_df['80_20_Split']) * 100

print("\n" + "=" * 60)
print("COMPARISON OF MODEL PERFORMANCE: 80:20 vs 60:40 Split")
print("=" * 60)
print(results_df.to_string(index=False,
                           formatters={
                               '80_20_Split': '{:.4%}'.format,
                               '60_40_Split': '{:.4%}'.format,
                               'Difference': '{:+.2f}%'.format
                           }))

plt.figure(figsize=(10, 6))
x = np.arange(len(results_df['Metric']))
width = 0.35
plt.bar(x - width/2, results_df['80_20_Split']*100, width, label='80:20 Split')

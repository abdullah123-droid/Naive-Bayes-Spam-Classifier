import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.model_selection import train_test_split
from sklearn.naive_bayes import GaussianNB
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import confusion_matrix, accuracy_score, precision_score, recall_score, f1_score
import warnings
warnings.filterwarnings('ignore')

df = pd.read_csv('spambase.data', header=None)

print("=" * 60)
print("DATA SUMMARY")
print("=" * 60)
print(f"Dataset shape: {df.shape}")
print(f"Number of instances: {df.shape[0]}")
print(f"Number of features: {df.shape[1] - 1}")
print(f"Target variable: Column {df.shape[1] - 1} (Spam indicator)")
print("\nFirst 5 rows of the dataset:")
print(df.head())
print("\nData types:")
print(df.dtypes)
print("\nBasic statistics:")
print(df.describe())
print("\nClass distribution (Spam vs Non-Spam):")
class_dist = df[57].value_counts()
print(f"Non-Spam (0): {class_dist[0]} instances ({class_dist[0]/len(df)*100:.2f}%)")
print(f"Spam (1): {class_dist[1]} instances ({class_dist[1]/len(df)*100:.2f}%)")
print("\nMissing values check:")
print(df.isnull().sum().sum())

print(f"   Data types: All numerical (integer/real)")


print(f"\n4. COMPREHENSIVE FEATURE STATISTICS:")
print("-" * 100)


stats_df = pd.DataFrame({
    'Feature': [f'Feature_{i}' for i in range(57)] + ['Target'],
    'Min': df.min(),
    'Q1': df.quantile(0.25),
    'Median': df.median(),
    'Mean': df.mean(),
    'Q3': df.quantile(0.75),
    'Max': df.max(),
    'Std': df.std(),
    'Variance': df.var()
})


print("\nFirst 10 features statistics:")
print(stats_df.head(10).round(4))


print(f"\n5. TARGET VARIABLE STATISTICS (Column 57):")
target_stats = stats_df.iloc[57]
print(f"   Min: {target_stats['Min']:.0f}")
print(f"   Q1: {target_stats['Q1']:.0f}")
print(f"   Median: {target_stats['Median']:.0f}")
print(f"   Mean: {target_stats['Mean']:.4f}")
print(f"   Q3: {target_stats['Q3']:.0f}")
print(f"   Max: {target_stats['Max']:.0f}")
print(f"   Std: {target_stats['Std']:.4f}")


print(f"\n6. FEATURE TYPE BREAKDOWN (as per dataset description):")
print(f"   48 word_freq_WORD features: Percentage of words matching specific words [0-100]")
print(f"   6 char_freq_CHAR features: Percentage of characters matching specific chars [0-100]")
print(f"   1 capital_run_length_average: Average length of capital letter sequences [1-∞]")
print(f"   1 capital_run_length_longest: Longest capital letter sequence [1-∞]")
print(f"   1 capital_run_length_total: Total capital letters [1-∞]")


print(f"\n7. TOP 10 FEATURES MOST CORRELATED WITH TARGET:")
correlations = df.corr()[57].abs().sort_values(ascending=False)
top_corr_features = correlations.head(11)
for i, (feature, corr) in enumerate(top_corr_features.items()):
    if i > 0:
        print(f"   {i:2d}. Feature {feature:2d}: {corr:.4f}")

X = df.iloc[:, :-1]
y = df.iloc[:, -1]


def evaluate_naive_bayes(X_train, X_test, y_train, y_test):
    nb_classifier = GaussianNB()
    nb_classifier.fit(X_train, y_train)
    y_pred = nb_classifier.predict(X_test)
    cm = confusion_matrix(y_test, y_pred)
    accuracy = accuracy_score(y_test, y_pred)
    precision = precision_score(y_test, y_pred)
    recall = recall_score(y_test, y_pred)
    f1 = f1_score(y_test, y_pred)
    tn, fp, fn, tp = cm.ravel()
    specificity = tn / (tn + fp)
    return cm, accuracy, precision, recall, specificity, f1, tn, fp, fn, tp

scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

X_train_80, X_test_80, y_train_80, y_test_80 = train_test_split(X_scaled, y, test_size=0.2, random_state=42, stratify=y)
X_train_60, X_test_60, y_train_60, y_test_60 = train_test_split(X_scaled, y, test_size=0.4, random_state=42, stratify=y)

print("\n" + "=" * 60)
print("TRAINING SET SIZES")
print("=" * 60)
print(f"80:20 Split - Training: {X_train_80.shape[0]}, Testing: {X_test_80.shape[0]}")
print(f"60:40 Split - Training: {X_train_60.shape[0]}, Testing: {X_test_60.shape[0]}")

print("\n" + "=" * 60)
print("MODEL PERFORMANCE RESULTS")
print("=" * 60)

cm_80, acc_80, prec_80, rec_80, spec_80, f1_80, tn_80, fp_80, fn_80, tp_80 = evaluate_naive_bayes(X_train_80, X_test_80, y_train_80, y_test_80)
cm_60, acc_60, prec_60, rec_60, spec_60, f1_60, tn_60, fp_60, fn_60, tp_60 = evaluate_naive_bayes(X_train_60, X_test_60, y_train_60, y_test_60)

print("\nPerformance Metrics:")
